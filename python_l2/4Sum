# Given an array nums of n integers, return an array of all the unique quadruplets [nums[a], nums[b], nums[c], nums[d]] such that:
# 0 <= a, b, c, d < n
# a, b, c, and d are distinct.
# nums[a] + nums[b] + nums[c] + nums[d] == target
# You may return the answer in any order.

# Example 1:
# Input: nums = [1,0,-1,0,-2,2], target = 0
# Output: [[-2,-1,1,2],[-2,0,0,2],[-1,0,0,1]]
class Solution:
    def fourSum(self, nums: List[int], target: int) -> List[List[int]]:
        nums.sort()
        res = []
        # Check if the list has fewer than 4 elements
        if len(nums) < 4:
            return res
        for i in range(len(nums)-3):
            #skip duplicates for first elem
            if i>0 and nums[i]==nums[i-1]:
                continue
            #making 2nd elem fixed
            for j in range(i+1, len(nums)-2):
                # check duplicates for  2nd fixed element
                if (j>(i+1) and nums[j]==nums[j-1]):
                    continue
                #Now, selecting the remaining 2 elements
                l, r = j+1, len(nums)-1
                while l<r:
                    curr_sum = nums[i] + nums[j] + nums[l] + nums[r]
                    if curr_sum == target:
                        res.append([nums[i], nums[j],nums[l],nums[r]])
                        #Skip duplicates for the third number
                        while (l<r and nums[l]==nums[l+1]):
                            l+=1
                        #Skip duplicate for fourth element
                        while l<r and nums[r]==nums[r-1]:
                            r-=1
                        l+=1
                        r-=1
                    elif (curr_sum<target):
                        l+=1  # need a larger sum                        
                    else:
                        r-=1 #need a smaller sum
        return res        
