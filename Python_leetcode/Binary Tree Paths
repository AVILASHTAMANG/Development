# DFS using stack to avoid deep recursion leading to stack overflow
        if not root:
            return
        stack = [(root, str(root.val))]
        paths = []
        while stack:
            node, path = stack.pop()
            if not node.left and not node.right:
                paths.append(path)
            if node.left:
                stack.append((node.left, path + "->" + str(node.left.val)))
            if node.right:
                stack.append((node.right, path + "->" + str(node.right.val)))
        return paths
        
