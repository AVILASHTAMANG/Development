    def dayOfYear(self, date: str) -> int:
        y, m, d = map(int, date.split('-'))
        mDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
        
        # Add one day to February if it's a leap year
        if (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0):
            mDays[1] += 1
        
        return sum(mDays[:m - 1]) + d
