class Solution:
    def findTheLongestBalancedSubstring(self, s: str) -> int:
        i = 0
        n = len(s)
        count = 0
        while (i<n):
            zeros = 0
            ones = 0
            while i<n and s[i] == '0':
                zeros += 1
                i +=1
            while i<n and s[i] == '1':
                ones += 1
                i += 1
            count = max(count, 2*min(zeros, ones))
        return count
