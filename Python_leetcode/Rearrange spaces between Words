class Solution:
    def reorderSpaces(self, text: str) -> str:
        space_count = sum(1 for i in text if i == ' ')
        words = text.split()
        if len(words) == 1:
            return words[0] + ' ' * space_count
        spaces_between = space_count // (len(words)-1)
        extra_spaces = space_count % (len(words) - 1)
        result = (' ' * spaces_between).join(words)
        result += ' ' * extra_spaces
        return result
