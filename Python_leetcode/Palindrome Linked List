# Given the head of a singly linked list, return true if it is a or false otherwise.

# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def isPalindrome(self, head: Optional[ListNode]) -> bool:
        curr = head
        l =[]
        while curr!=None:
            if curr.val!=None:
                l.append(curr.val)
                curr=curr.next
        return l[::-1]==l        
