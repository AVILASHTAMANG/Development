class Solution:
    def getSmallestString(self, s: str) -> str:
        min_s = s
        s_list = list(s)
        for i in range(len(s)-1):
            a, b = s_list[i], s_list[i+1]
            if (int(a)%2) == (int(b)%2):
                s_list[i], s_list[i+1] = s_list[i+1], s_list[i]
                new_s = ''.join(s_list)
                if new_s < min_s:
                    min_s = new_s
                s_list[i], s_list[i+1] = s_list[i+1], s_list[i]
        return min_s
