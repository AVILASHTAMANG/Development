    def strongPasswordCheckerII(self, password: str) -> bool:
        if len(password) < 8:
            return False
        if not re.search(r'[a-z]',password):
            return False
        if not re.search(r'[A-Z]',password):
            return False
        if not re.search(r'[0-9]',password):
            return False
        if not re.search(r'[!@#$%^&*()\-\+]',password):
            return False
        for i in range(1, len(password)):
            if password[i] == password[i-1]:
                return False
        return True
