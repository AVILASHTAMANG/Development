import re
class Solution:
    def secondHighest(self, s: str) -> int:
        digits = re.findall(r"\d", s)
        unique_digits = sorted(set(int(d) for d in digits), reverse=True)
        if unique_digits == None or len(unique_digits)<2:
            return -1
        else:
            return unique_digits[1]
