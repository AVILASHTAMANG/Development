class Solution:
    def longestPalindrome(self, s: str) -> int:
        freq = {}
        for char in s:
            if char in freq:
                freq[char] += 1
            else:
                freq[char] = 1
        palindrome_length = 0
        odd_found = False
        for count in freq.values():
            if count%2 == 0:
                palindrome_length += count
            else:
                palindrome_length +=count - 1
                odd_found = True
        if odd_found:
            palindrome_length +=1
        return palindrome_length
