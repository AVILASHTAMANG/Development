#Single swap of two characters:
class Solution:
    def buddyStrings(self, s: str, goal: str) -> bool:
        if len(s) != len(goal):
            return False
        if s== goal:
            return len(set(s)) < len(s)
        diff = [(a,b) for a,b in zip(s,goal) if a != b]
        return len(diff) == 2 and diff[0] == diff[1][::-1]
#Multiple Swaps : Anagrams logic
class Solution:
    def canTransformBySwaps(self, s: str, goal: str) -> bool:
        if len(s) != len(goal):
            return False
        return sorted(s) == sorted(goal)
