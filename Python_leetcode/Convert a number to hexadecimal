class Solution:
    def toHex(self, num: int) -> str:
        if num == 0:
            return "0"
        hex_chars = "0123456789abcdef"
        res =""
        if num<0:
            num = num & 0xFFFFFFFF
        while num>0:
            rem = num % 16
            res = hex_chars[rem] + res
            num = num // 16
        return res
