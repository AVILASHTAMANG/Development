class Solution:
    def minimumOperations(self, grid: List[List[int]]) -> int:
        rows = len(grid)
        cols = len(grid[0])
        min_ops = 0
        for j in range(cols):
            for i in range(1, rows):
                if grid[i][j] <= grid[i-1][j]:
                    min_ops += grid[i-1][j] - grid[i][j] + 1
                    grid[i][j] = grid[i-1][j] + 1
        return min_ops
