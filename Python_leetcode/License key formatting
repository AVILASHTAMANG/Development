class Solution:
    def licenseKeyFormatting(self, s: str, k: int) -> str:
        place =s.replace('-','')[::-1].upper()
        ans=[]
        for i in range(len(place)):
            if i>0 and i%k==0:
                ans.append('-')
            ans.append(place[i])
        return ''.join(ans[::-1])
