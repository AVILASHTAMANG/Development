class Solution:
    def shortestToChar(self, s: str, c: str) -> List[int]:
        n = len(s)
        prev = float('-inf')
        ans = [0] * n
        # Left to right scan
        for i in range(n):
            if s[i] == c:
                prev = i
            ans[i] = i - prev
        # Right to left scan
        prev = float('inf')
        for i in range(n - 1, -1, -1):
            if s[i] == c:
                prev = i
            ans[i] = min(ans[i], prev - i)

        return ans
