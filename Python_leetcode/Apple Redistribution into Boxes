class Solution:
    def minimumBoxes(self, apple: List[int], capacity: List[int]) -> int:
        total_apples = sum(apple)
        capacity.sort(reverse = True)
        boxes_used = 0
        curr_capacity = 0
        for cap in capacity:
            curr_capacity += cap
            boxes_used += 1
            if curr_capacity >= total_apples:
                return boxes_used
        return -1        
