class Solution:
    def areAlmostEqual(self, s1: str, s2: str) -> bool:
        if s1 == s2:
            return True
        elif len(s1)!=len(s2):
            return False
        mismatches=[]
        for i in range(len(s1)):
            if s1[i]!=s2[i]:
                mismatches.append(i)
        if len(mismatches)!=2:
            return False
        i,j = mismatches
        s2= list(s2)      
        s2[i],s2[j] = s2[j],s2[i]
        return s1 == ''.join(s2)
