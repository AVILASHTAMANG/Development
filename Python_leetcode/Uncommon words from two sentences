class Solution:
    def uncommonFromSentences(self, s1: str, s2: str) -> List[str]:
        words = (s1+ " " + s2).split()
        freq={}
        for word in words:
            if word in freq:
                freq[word] +=1
            else:
                freq[word] = 1
        return[w for w in freq if freq[w] == 1]
