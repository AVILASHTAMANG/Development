class Solution:
    def equalFrequency(self, word: str) -> bool:
        freq =[0] * 26
        for char in word:
            freq[ord(char) - ord('a')] +=1
        for i in range(26):
            if freq[i] == 0:
                continue
            freq[i] -= 1
            non_zero_freq = [f for f in freq if f > 0]
            if len(set(non_zero_freq)) == 1:
                return True
            freq[i] +=1
        return False
